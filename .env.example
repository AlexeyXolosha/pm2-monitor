# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата/пользователя, куда слать сообщения.
# Узнать свой ID можно, написав боту @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# Как часто опрашивать pm2. Формат Go: "30s", "5m", "1h"
CHECK_INTERVAL=1h

# Порог RAM (в мегабайтах) — если процесс превысил, придёт алерт
MEMORY_LIMIT_MB=1024
